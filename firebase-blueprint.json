{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A hardware product in the inventory.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the product" },
        "pn": { "type": "string", "description": "Part Number" },
        "category": { "type": "string", "description": "Category of the product" },
        "price": { "type": "number", "description": "Unit price" },
        "image": { "type": "string", "description": "URL of the product image" },
        "total": { "type": "number", "description": "Total units in stock" },
        "available": { "type": "number", "description": "Available units for use" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["name", "pn", "category", "price"]
    },
    "Unit": {
      "title": "Unit",
      "description": "An individual unit of a product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "Reference to the Product ID" },
        "sn": { "type": "string", "description": "Serial Number" },
        "status": { "type": "string", "enum": ["Disponível", "Utilizada", "Vendida", "Manutenção"], "description": "Current status of the unit" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last status update" }
      },
      "required": ["productId", "sn", "status"]
    }
  },
  "firestore": {
    "/products": {
      "schema": "Product",
      "description": "Collection of hardware products"
    },
    "/products/{productId}/units": {
      "schema": "Unit",
      "description": "Subcollection of individual units for a specific product"
    }
  }
}
