# Public Supabase configuration used by the Next.js client.
# These values are safe to expose in the browser, but should still be set
# per environment instead of hardcoded in the source code.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
